{
  "name": "yurutoreclub-mobile",
  "private": true,
  "description": "Capacitor shell that bundles the existing web app locally (no server.url, no runtime CDN).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:staging": "node scripts/build-mobile.cjs --target=staging",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "8.0.1",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.5.3",
    "@supabase/supabase-js": "2.118.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@capacitor/cli": "8.5.3",
    "jsdom": "26.1.0"
  }
}
